# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Render production values:
# VITE_API_URL=https://hincton-meat-api.onrender.com/api
# VITE_SOCKET_URL=https://hincton-meat-api.onrender.com

# M-PESA Configuration
VITE_MPESA_ENABLED=true

# Application Settings
VITE_APP_NAME="Premium Meat Shop"
VITE_APP_DESCRIPTION="Premium quality meats delivered to your doorstep"

# Google Maps (for delivery tracking)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"

# Environment
VITE_NODE_ENV="development"

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false

# Currency Settings
VITE_CURRENCY="KES"
VITE_CURRENCY_SYMBOL="KSh"

# Contact Information
VITE_CONTACT_PHONE="+254 700 123 456"
VITE_CONTACT_EMAIL="info@premiummeatshop.com"
VITE_CONTACT_ADDRESS="123 Nairobi Street, Nairobi, Kenya"

# Social Media Links
VITE_FACEBOOK_URL="https://facebook.com/premiummeatshop"
VITE_TWITTER_URL="https://twitter.com/premiummeatshop"
VITE_INSTAGRAM_URL="https://instagram.com/premiummeatshop"

# Business Hours
VITE_BUSINESS_HOURS="Mon-Sat: 8AM-8PM, Sun: 9AM-6PM"

# Delivery Settings
VITE_FREE_SHIPPING_THRESHOLD=50
VITE_STANDARD_SHIPPING_FEE=9.99
VITE_EXPRESS_SHIPPING_FEE=19.99

# Payment Methods
VITE_ACCEPT_MPESA=true
VITE_ACCEPT_CARD=true
VITE_ACCEPT_CASH_ON_DELIVERY=false
