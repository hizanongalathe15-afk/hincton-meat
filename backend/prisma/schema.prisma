generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  phone                  String?                 @unique
  username               String?                 @unique
  roles                  Role[]                  @default([BUYER])
  walletBalance          Decimal?                @default(0) @db.Decimal(12, 2)
  voucherBalance         Decimal?                @default(0) @db.Decimal(12, 2)
  loyaltyPoints          Int?                    @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  abandonedCartReminders AbandonedCartReminder[]
  abandonedCarts         AbandonedCart[]
  addresses              Address[]
  affiliate              Affiliate?              @relation("UserAffiliate")
  analyticsEvents        AnalyticsEvent[]
  analyticsSessions      AnalyticsSession[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  backInStockAlerts      BackInStockAlert[]
  blogComments           BlogComment[]
  blogPosts              BlogPost[]
  cart                   Cart?
  commissions            Commission[]
  couponUsages           CouponUsage[]
  favorites              Favorite[]
  flashSalePurchases     FlashSalePurchase[]
  followers              Follow[]                @relation("UserFollowers")
  following              Follow[]                @relation("UserFollowing")
  invoices               Invoice[]
  liveChatsAdmin         LiveChatMessage[]       @relation("AdminChats")
  liveChats              LiveChatMessage[]
  loginHistory           LoginHistory[]
  loyaltyRedemptions     LoyaltyRedemption[]
  notifications          Notification[]
  orders                 Order[]
  paymentMethods         PaymentMethod[]
  payments               Payment[]
  promotionUsages        PromotionUsage[]
  priceDropAlerts        PriceDropAlert[]
  pageViews              PageView[]
  productViews           ProductView[]
  referralsMade          Referral?
  clicks                 Click[]
  returnRequests         ReturnRequest[]
  reviews                Review[]
  loginAttempts          LoginAttempt[]
  searchHistory          SearchHistory[]
  searchQueries          SearchQuery[]
  socialAccounts         SocialAccount[]
  subscription           Subscription?           @relation("UserSubscription")
  supportTickets         SupportTicket[]
  profile                UserProfile?
  security               UserSecurity?
  userSessions           UserSession[]
  settings               UserSettings?
  vendor                 Vendor?
  walletTransactions     WalletTransaction[]
  wishlist               Wishlist?
  adCampaigns            AdCampaign[]
  forumThreads           ForumThread[]
  forumReplies           ForumReply[]
  vipBypassRequests      VipBypassRequest[]
  photoReviews           PhotoReview[]

  @@index([email])
  @@index([phone])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

model SocialAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@map("social_accounts")
}

model UserProfile {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  firstName                 String?
  lastName                  String?
  fullName                  String?
  avatar                    String?
  coverImage                String?
  bio                       String?
  website                   String?
  dateOfBirth               DateTime?
  gender                    String?
  mpesaPhone                String?
  preferredDeliveryLocation String?
  preferredPickupStation    String?
  deliveryInstructions      String?
  locationLatitude          Float?
  locationLongitude         Float?
  locationSource            String?
  locationLabel             String?
  preferredLanguage         Language  @default(EN)
  preferredCurrency         Currency  @default(USD)
  theme                     Theme     @default(SYSTEM)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSecurity {
  id                    String      @id @default(cuid())
  userId                String      @unique
  password_hash         String?
  isEmailVerified       Boolean     @default(false)
  isPhoneVerified       Boolean     @default(false)
  is_active             Boolean     @default(true)
  is_locked             Boolean     @default(false)
  lock_reason           String?
  is_2fa_enabled        Boolean     @default(false)
  two_factor_secret     String?
  backup_codes          Json        @default("[]")
  login_attempts        Int         @default(0)
  last_login_at         DateTime?
  last_login_ip         String?
  last_login_device     DeviceType?
  locked_until          DateTime?
  password_changed_at   DateTime?
  reset_token           String?
  reset_token_expires   DateTime?
  reset_otp             String?
  reset_otp_expires     DateTime?
  email_otp             String?
  email_otp_expires     DateTime?
  phone_otp             String?
  phone_otp_expires     DateTime?
  refresh_token         String?
  refresh_token_expires DateTime?
  previous_passwords    Json        @default("[]")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reset_token])
  @@index([refresh_token])
  @@map("user_security")
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailOrder            Boolean  @default(true)
  emailPromotion        Boolean  @default(true)
  emailNewsletter       Boolean  @default(true)
  smsOrder              Boolean  @default(true)
  smsPromotion          Boolean  @default(false)
  pushOrder             Boolean  @default(true)
  pushPromotion         Boolean  @default(true)
  pushBackInStock       Boolean  @default(true)
  pushPriceDrop         Boolean  @default(true)
  marketingConsent      Boolean  @default(false)
  dataProcessingConsent Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Vendor {
  id             String                @id @default(cuid())
  userId         String                @unique
  businessName   String
  businessEmail  String
  businessPhone  String?
  logo           String?
  coverImage     String?
  description    String?
  website        String?
  taxId          String?
  commissionRate Decimal               @default(10.0) @db.Decimal(5, 2)
  totalSales     Decimal               @default(0) @db.Decimal(12, 2)
  balance        Decimal               @default(0) @db.Decimal(12, 2)
  totalWithdrawn Decimal               @default(0) @db.Decimal(12, 2)
  rating         Float                 @default(0)
  reviewCount    Int                   @default(0)
  status         VendorStatus          @default(PENDING)
  verifiedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  products       Product[]
  address        VendorAddress?
  paymentDetails VendorPaymentDetails?
  vendorPayouts  VendorPayout[]
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("vendors")
}

model VendorAddress {
  id           String   @id @default(cuid())
  vendorId     String   @unique
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_addresses")
}

model VendorPaymentDetails {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  bankName      String?
  accountName   String?
  accountNumber String?
  routingNumber String?
  paypalEmail   String?
  mpesaPhone    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_payment_details")
}

model VendorPayout {
  id            String       @id @default(cuid())
  vendorId      String
  amount        Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  paymentMethod String?
  processedAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  vendor        Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@map("vendor_payouts")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  shortDescription  String?
  price             Decimal  @db.Decimal(10, 2)
  comparePrice      Decimal? @db.Decimal(10, 2)
  costPrice         Decimal? @db.Decimal(10, 2)
  wholesalePrice    Decimal? @db.Decimal(10, 2)
  sku               String   @unique
  barcode           String?
  mpn               String?
  gtin              String?
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  stockStatus       String   @default("in_stock")
  weightUnit        String? // e.g. kg, g, 400g, 1kg, ml (UI-editable)
  weight            Float?
  length            Float?
  width             Float?
  height            Float?

  brand                     String?
  vendorId                  String?
  categoryId                String?
  averageRating             Float                      @default(0)
  totalReviews              Int                        @default(0)
  totalSold                 Int                        @default(0)
  isPublished               Boolean                    @default(false)
  isFeatured                Boolean                    @default(false)
  isNew                     Boolean                    @default(false)
  isOnSale                  Boolean                    @default(false)
  isDigital                 Boolean                    @default(false)
  isPreorder                Boolean                    @default(false)
  preorderDate              DateTime?
  seoTitle                  String?
  seoDescription            String?
  metaKeywords              String?
  canonicalUrl              String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  publishedAt               DateTime?
  deletedAt                 DateTime?
  backInStockAlerts         BackInStockAlert[]
  cartItems                 CartItem[]
  favorites                 Favorite[]
  flashSaleProducts         FlashSaleProduct[]
  flashSalePurchases        FlashSalePurchase[]
  inventoryLogs             InventoryLog[]
  orderItems                OrderItem[]
  priceDropAlerts           PriceDropAlert[]
  priceHistory              PriceHistory[]
  productAttributes         ProductAttribute[]
  productImages             ProductImage[]
  variants                  ProductVariant[]
  productVideos             ProductVideo[]
  productViews              ProductView[]
  category                  Category?                  @relation(fields: [categoryId], references: [id])
  vendor                    Vendor?                    @relation(fields: [vendorId], references: [id])
  returnRequests            ReturnRequest[]
  reviews                   Review[]
  wishlistItems             WishlistItem[]
  subscriptionDeliveryItems SubscriptionDeliveryItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([vendorId])
  @@index([brand])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([isPublished, deletedAt, createdAt(sort: Desc)])
  @@index([categoryId, isPublished, deletedAt])
  @@index([price])
  @@map("products")
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  name      String
  value     String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@index([name])
  @@map("product_attributes")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

model ProductVideo {
  id          String   @id @default(cuid())
  productId   String
  url         String
  provider    String   @default("youtube")
  thumbnail   String?
  title       String?
  description String?
  duration    Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  name              String?
  sku               String             @unique
  barcode           String?
  price             Decimal?           @db.Decimal(10, 2)
  comparePrice      Decimal?           @db.Decimal(10, 2)
  costPrice         Decimal?           @db.Decimal(10, 2)
  stockQuantity     Int                @default(0)
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  isDefault         Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cartItems         CartItem[]
  flashSaleProducts FlashSaleProduct[]
  orderItems        OrderItem[]
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnRequests    ReturnRequest[]
  attributes        VariantAttribute[]
  wishlistItems     WishlistItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@map("product_variants")
}

model VariantAttribute {
  id        String         @id @default(cuid())
  variantId String
  name      String
  value     String
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, name])
  @@index([variantId])
  @@map("variant_attributes")
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  image          String?
  bannerImage    String?
  icon           String?
  parentId       String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  parent         Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryToCategory")
  products       Product[]
  dealBanners    DealBanner[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("categories")
}

model Occasion {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("occasions")
}

model Order {
  id                         String               @id @default(cuid())
  orderNumber                String               @unique
  idempotencyKey             String?
  userId                     String?
  guestEmail                 String?
  guestPhone                 String?
  guestSessionId             String?
  status                     OrderStatus          @default(PENDING)
  paymentStatus              PaymentStatus        @default(UNPAID)
  deliveryStatus             DeliveryStatus       @default(PENDING)
  subtotal                   Decimal              @db.Decimal(12, 2)
  shippingCost               Decimal              @default(0) @db.Decimal(10, 2)
  taxAmount                  Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount             Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount                Decimal              @db.Decimal(12, 2)
  currency                   Currency             @default(USD)
  couponCode                 String?
  couponDiscount             Decimal              @default(0) @db.Decimal(10, 2)
  shippingAddress            Json
  billingAddress             Json?
  shippingMethod             String?
  trackingNumber             String?
  courier                    String?
  trackingUrl                String?
  pickupStationId            String?
  pickupCode                 String?              @unique
  pickupCodeExpiresAt        DateTime?
  qrSecret                   String?              @unique
  qrSecretExpiresAt          DateTime?
  verificationMethod         VerificationMethod   @default(HYBRID)
  idVerified                 Boolean              @default(false)
  idLast4                    String?
  pickedAt                   DateTime?
  pickedByAgentId            String?
  verificationAttempts       Int                  @default(0)
  failedVerificationAttempts Int                  @default(0)
  lockedUntil                DateTime?
  estimatedDelivery          DateTime?
  deliveredAt                DateTime?
  notes                      String?
  adminNotes                 String?
  ipAddress                  String?
  userAgent                  String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  cancelledAt                DateTime?
  refundedAt                 DateTime?
  deletedAt                  DateTime?
  pickupAudits               OrderPickupAudit[]
  commissions                Commission[]
  couponUsages               CouponUsage?
  promotionUsages            PromotionUsage[]
  flashSalePurchases         FlashSalePurchase[]
  invoices                   Invoice[]
  orderItems                 OrderItem[]
  statusHistory              OrderStatusHistory[]
  pickupStation              PickupStation?       @relation(fields: [pickupStationId], references: [id])
  user                       User?                @relation(fields: [userId], references: [id])
  payments                   Payment[]
  refunds                    Refund[]
  returnRequests             ReturnRequest[]
  supportTickets             SupportTicket[]
  trackingHistory            TrackingHistory[]

  @@index([orderNumber])
  @@index([idempotencyKey])
  @@index([userId])
  @@index([guestEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([pickupStationId])
  @@index([deletedAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model PickupStation {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  region    String?
  country   String?  @default("Kenya")
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model OrderPickupAudit {
  id            String             @id @default(cuid())
  orderId       String
  agentId       String?
  method        VerificationMethod
  codeAttempted String?
  idLast4       String?
  verified      Boolean            @default(false)
  notes         String?
  createdAt     DateTime           @default(now())
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String
  productImage   String?
  sku            String?
  quantity       Int
  unitPrice      Decimal         @db.Decimal(10, 2)
  totalPrice     Decimal         @db.Decimal(10, 2)
  discount       Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(10, 2)
  isDigital      Boolean         @default(false)
  downloadUrl    String?
  createdAt      DateTime        @default(now())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  returnRequests ReturnRequest[]
  review         Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@map("order_status_history")
}

model Payment {
  id                   String        @id @default(cuid())
  orderId              String
  userId               String?
  amount               Decimal       @db.Decimal(12, 2)
  currency             Currency      @default(USD)
  paymentMethod        String
  paymentReference     String?
  status               PaymentStatus @default(PENDING)
  metadata             Json?
  errorMessage         String?
  mpesaReceipt         String?
  mpesaPhone           String?
  mpesaTransactionDate DateTime?
  createdAt            DateTime      @default(now())
  completedAt          DateTime?
  order                Order         @relation(fields: [orderId], references: [id])
  user                 User?         @relation(fields: [userId], references: [id])
  refunds              Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([paymentReference])
  @@index([mpesaReceipt])
  @@index([status])
  @@map("payments")
}

model Refund {
  id              String        @id @default(cuid())
  paymentId       String
  orderId         String
  amount          Decimal       @db.Decimal(12, 2)
  reason          String?
  status          PaymentStatus @default(PENDING)
  refundReference String?
  processedBy     String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  order           Order         @relation(fields: [orderId], references: [id])
  payment         Payment       @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([orderId])
  @@map("refunds")
}

model WalletTransaction {
  id           String          @id @default(cuid())
  userId       String
  amount       Decimal         @db.Decimal(12, 2)
  type         TransactionType
  reason       String?
  reference    String?
  balanceAfter Decimal         @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model Coupon {
  id                String           @id @default(cuid())
  code              String           @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal          @db.Decimal(10, 2)
  minimumSpend      Decimal?         @db.Decimal(10, 2)
  maximumDiscount   Decimal?         @db.Decimal(10, 2)
  usageLimit        Int?
  usageLimitPerUser Int              @default(1)
  usedCount         Int              @default(0)
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean          @default(true)
  stackable         Boolean          @default(false)
  firstOrderOnly    Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  abandonedCarts    AbandonedCart[]
  couponCategories  CouponCategory[]
  couponProducts    CouponProduct[]
  usages            CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validUntil])
  @@index([deletedAt])
  @@map("coupons")
}

model CouponProduct {
  id        String   @id @default(cuid())
  couponId  String
  productId String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([couponId])
  @@map("coupon_products")
}

model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  categoryId String
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([couponId])
  @@map("coupon_categories")
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model Affiliate {
  id              String            @id @default(cuid())
  userId          String            @unique
  referralCode    String            @unique
  commissionRate  Decimal           @default(5.0) @db.Decimal(5, 2)
  totalEarnings   Decimal           @default(0) @db.Decimal(12, 2)
  totalWithdrawn  Decimal           @default(0) @db.Decimal(12, 2)
  balance         Decimal           @default(0) @db.Decimal(12, 2)
  clickCount      Int               @default(0)
  conversionCount Int               @default(0)
  status          String            @default("active")
  bannerImage     String?
  landingPageUrl  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  payouts         AffiliatePayout[]
  user            User              @relation("UserAffiliate", fields: [userId], references: [id], onDelete: Cascade)
