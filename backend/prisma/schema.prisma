// ============================================================================
// COMMUNITY FORUMS
// ============================================================================

model ForumCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  icon        String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  threads     ForumThread[]

  @@index([slug])
  @@map("forum_categories")
}

model ForumThread {
  id          String        @id @default(cuid())
  categoryId  String
  userId      String
  title       String
  body        String        @db.Text
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  isSolved    Boolean       @default(false)
  views       Int           @default(0)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     ForumReply[]

  @@index([categoryId])
  @@index([userId])
  @@index([createdAt])
  @@map("forum_threads")
}

model ForumReply {
  id           String      @id @default(cuid())
  threadId     String
  userId       String
  body         String      @db.Text
  isAccepted   Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  thread       ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([userId])
  @@map("forum_replies")
}

// ============================================================================
// INTERACTIVE DECISION TREE
// ============================================================================

model DecisionTreeNode {
  id          String   @id @default(cuid())
  key         String   @unique
  question    String
  isRoot      Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  options     DecisionTreeOption[]

  @@index([isRoot])
  @@map("decision_tree_nodes")
}

model DecisionTreeOption {
  id           String            @id @default(cuid())
  nodeId       String
  label        String
  nextNodeId   String?
  resolution   String?           @db.Text
  linkUrl      String?
  linkLabel    String?
  sortOrder    Int               @default(0)
  node         DecisionTreeNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("decision_tree_options")
}

// ============================================================================
// VIP EMERGENCY BYPASS
// ============================================================================

model VipBypassRequest {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  name        String
  orderRef    String?
  issue       String    @db.Text
  status      String    @default("PENDING")
  adminNote   String?   @db.Text
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("vip_bypass_requests")
}

// ============================================================================
// PAGE SNAPSHOTS (read-only cached view during maintenance)
// ============================================================================

model PageSnapshot {
  id          String    @id @default(cuid())
  pageKey     String    @unique
  title       String
  htmlContent String    @db.Text
  capturedAt  DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageKey])
  @@map("page_snapshots")
}

// ============================================================================
// CAREERS / JOB POSTINGS
// ============================================================================

model JobPosting {
  id              String           @id @default(cuid())
  title           String
  department      String
  location        String
  type            String           // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP
  description     String           @db.Text
  requirements    String           @db.Text
  salaryRange     String?
  deadline        DateTime?
  maxSpots        Int              @default(1)
  googleFormUrl   String?
  status          String           @default("OPEN") // OPEN, CLOSED, PAUSED
  applications    JobApplication[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@map("job_postings")
}

model JobApplication {
  id          String     @id @default(cuid())
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String
  coverLetter String?    @db.Text
  cvUrl       String?
  status      String     @default("NEW") // NEW, REVIEWED, SHORTLISTED, INTERVIEW, HIRED, REJECTED
  notes       String?    @db.Text
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

// ============================================================================
// GIFT CARDS
// ============================================================================

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  amount         Float
  balance        Float
  currency       String    @default("KES")
  senderName     String
  senderEmail    String?
  recipientName  String
  recipientEmail String?
  recipientPhone String?
  message        String?   @db.Text
  occasion       String?   // WEDDING, EID, BIRTHDAY, CHRISTMAS, THANK_YOU, FUNERAL
  template       String?
  deliveryMethod String    @default("EMAIL") // EMAIL, WHATSAPP, PRINT
  status         String    @default("ACTIVE") // ACTIVE, REDEEMED, EXPIRED
  expiresAt      DateTime?
  purchasedBy    String?
  redeemedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([status])
  @@index([recipientEmail])
  @@index([createdAt])
  @@map("gift_cards")
}

