  conversions AdConversion[]

  @@map("ad_placements")
}

model AdCampaign {
  id           String   @id @default(cuid())
  name         String
  advertiserId String
  budget       Json // { total: number, daily?: number, cpc?: number, cpm?: number, cpa?: number }
