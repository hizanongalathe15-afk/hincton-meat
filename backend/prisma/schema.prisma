  path       String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([name])
  @@index([userId])
  @@index([sessionId])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("analytics_events")
}

model AnalyticsTouchpoint {
  id              String   @id @default(cuid())
  sessionId       String?
  userId          String?
  orderId         String?
  eventId         String?
  eventName       String
  touchpointIndex Int      @default(1)
  source          String   @default("direct")
  medium          String?
  campaign        String?
  term            String?
  content         String?
  path            String?
  linkId          String?
  linkUrl         String?
  referrer        String?
  ipAddress       String?
  userAgent       String?
  deviceType      String?
  browser         String?
  os              String?
  isConversion    Boolean  @default(false)
  creditShare     Decimal? @db.Decimal(10, 4)
  createdAt       DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([orderId])
  @@index([eventName])
  @@index([createdAt(sort: Desc)])
  @@map("analytics_touchpoints")
}

model AnalyticsAttribution {
  id                String    @id @default(cuid())
  orderId           String?   @unique
  sessionId         String?
  userId            String?
  conversionEventId String?
  firstTouchSource  String?
  lastTouchSource   String?
  touchpointCount   Int       @default(0)
  firstTouchAt      DateTime?
  lastTouchAt       DateTime?
  attributionJson   Json?
  createdAt         DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("analytics_attributions")
}

model AppInstall {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  userId      String?
  platform    String?
  version     String?
  installedAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  @@index([userId])
  @@index([platform])
  @@index([installedAt(sort: Desc)])
  @@map("app_installs")
}

model AppHeartbeat {
  id         String   @id @default(cuid())
  deviceId   String
  userId     String?
  screenName String?
  appVersion String?
  platform   String?
  createdAt  DateTime @default(now())

  @@index([deviceId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("app_heartbeat")
}

model AppScreen {
  id         String    @id @default(cuid())
  deviceId   String
  userId     String?
  screenName String
  duration   Int?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  @@index([deviceId])
  @@index([userId])
  @@index([screenName])
  @@index([openedAt(sort: Desc)])
  @@map("app_screens")
}

model AnalyticsReportSnapshot {
  id          String    @id @default(cuid())
  reportType  String
  period      String
  periodStart DateTime?
  periodEnd   DateTime?
  generatedAt DateTime  @default(now())
  reportData  Json

  @@index([reportType])
  @@index([period])
  @@index([generatedAt(sort: Desc)])
  @@map("analytics_report_snapshots")
}

