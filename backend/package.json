{
  "name": "hincton-backend",
  "version": "1.0.0",
  "description": "Backend API for hincton Meat Shop E-commerce Platform",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --ignore dist --ignore node_modules --ignore uploads src/server.ts",
    "build": "tsc",
    "render-build": "prisma generate && tsc",
    "seed": "ts-node src/utils/seedData.ts",
    "seed:hincton": "ts-node src/utils/seedHinctonPricelist.ts",
    "seed:admins": "ts-node src/utils/seedAdmins.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "keywords": [
    "meat",
    "ecommerce",
    "nodejs",
    "typescript",
    "express",
    "prisma"
  ],
  "author": "Hincton Meat Shop",
  "license": "MIT",
  "dependencies": {
    "@cloudinary/url-gen": "^1.19.0",
    "@prisma/client": "^5.22.0",
    "@types/sharp": "^0.31.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node src/utils/seedData.ts"
  }
}
